{
  "name": "gbh",
  "version": "0.0.0-reconstructed",
  "private": true,
  "description": "Rebuild the retained bfe1879 host with configurable local execution",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && python3 runtime/tools/build-bundles.py",
    "check": "tsc -p tsconfig.local.json",
    "check:syntax": "python3 tools/ci/check-syntax.py",
    "ci:pre-commit": "python3 tools/ci/check-staged.py",
    "ci:pre-pr": "python3 tools/ci/run-required-gates.py --pre-pr",
    "ci:required": "python3 tools/ci/run-required-gates.py",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "recover": "python3 tools/recover-native.py",
    "test:recovery": "python3 -m unittest discover -s tools -p \"test_*.py\"",
    "test:ci-gates": "python3 tools/test_ci_gates.py",
    "maintenance": "python3 tools/maintenance.py",
    "hooks:install": "python3 tools/install-pre-commit.py",
    "build:runtime": "npm run build",
    "start": "node runtime/manage.cjs start",
    "stop": "node runtime/manage.cjs stop",
    "status": "node runtime/manage.cjs status",
    "logs": "node runtime/manage.cjs logs",
    "start:desktop": "node runtime/desktop.cjs",
    "prepare:desktop": "python3 runtime/tools/prepare-desktop.py",
    "check:local": "tsc -p tsconfig.local.json",
    "test:runtime-build": "python3 -m unittest discover -s runtime/tests -p \"test_*.py\"",
    "test:responses": "node runtime/tests/responses-live.cjs",
    "test:responses-contract": "node --test runtime/tests/responses-contract.cjs runtime/tests/auto-review-contract.cjs",
    "test:web-fetch": "node --test runtime/tests/web-fetch-contract.cjs",
    "test:web-search": "node --test runtime/tests/web-search-contract.cjs",
    "test:transcription": "node --test runtime/tests/transcription-contract.cjs",
    "test:tts": "node --test runtime/tests/tts-contract.cjs",
    "test:voice": "node --test runtime/tests/voice-call-contract.cjs runtime/tests/voice-server-contract.cjs",
    "test:desktop-voice": "node runtime/tests/desktop-voice-live.cjs",
    "test:voice-real-api": "node runtime/tests/voice-real-api-live.cjs",
    "test:desktop-tts": "node runtime/tests/desktop-tts-live.cjs",
    "test:transcription-live": "node runtime/tests/transcription-live.cjs",
    "test:desktop-transcription": "node runtime/tests/desktop-transcription-live.cjs",
    "test:mcp-store": "node --test runtime/tests/mcp-store-contract.cjs",
    "test:mcp-scopes": "node --test runtime/tests/mcp-scopes-contract.cjs",
    "test:desktop-live": "node runtime/tests/desktop-live.cjs",
    "test:mac-exec-live": "node runtime/tests/mac-exec-live.cjs",
    "plugins": "node runtime/plugins.cjs",
    "test:plugin-files": "node --test runtime/tests/plugin-files-contract.cjs",
    "test:plugins-live": "node runtime/tests/plugins-live.cjs",
    "build:icons": "python3 runtime/tools/build-icons.py",
    "package:mac": "npm run prepare:desktop -- --profile local && python3 runtime/tools/package-macos.py",
    "test:desktop-keychain": "node --test runtime/tests/local-keychain-contract.cjs",
    "test:desktop-keychain-live": "node runtime/tests/local-keychain-live.cjs",
    "docs:check": "python3 tools/export-wiki.py --check && python3 tools/check-guidance.py && python3 -m unittest discover -s tools -p 'test_docs_site.py' && node --test tools/test_docs_site_mermaid.cjs",
    "docs:wiki": "python3 tools/export-wiki.py",
    "docs:site:setup": "python3 tools/docs-site.py setup",
    "docs:site:prepare": "python3 tools/docs-site.py prepare",
    "docs:site:build": "python3 tools/docs-site.py build",
    "docs:site:serve": "python3 tools/docs-site.py serve",
    "docs:site:verify": "python3 tools/docs-site.py verify"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@mixmark-io/domino": "2.2.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "ws": "8.21.3"
  }
}
