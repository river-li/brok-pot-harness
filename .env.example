# Local execution; the build profile selects local/original before startup.
GROKBOT_RESPONSES_BASE_URL=http://litellm.home/v1
GROKBOT_MODEL=gpt-5.6-sol
GROKBOT_CONTEXT_TOKENS=128000
GROKBOT_REASONING_EFFORT=low
GROKBOT_INFERENCE_TIMEOUT_MS=180000
# The default search service runs locally in the same Docker Compose stack.
GROKBOT_SEARCH_BASE_URL=http://search:8080
GROKBOT_TRANSCRIPTION_BASE_URL=http://speech:8000
GROKBOT_TTS_BASE_URL=http://speech:8000
GROKBOT_SPEECH_THREADS=4
# Desktop voice-call entry point: 1 enabled, 0 disabled (restart desktop).
GROKBOT_LOCAL_VOICE=1
# Optional custom image; must provide the retained Box execution/display stack.
# GROKBOT_SANDBOX_IMAGE=gbh-sandbox:dev
# Optional ABSOLUTE host folder mounted read/write at /workspace.
# GROKBOT_WORKSPACE_DIR=/absolute/path/to/project
# Optional Compose overlay, relative to the repository root or absolute.
# GROKBOT_COMPOSE_OVERRIDE=.runtime/compose.local.yaml
# Prefer exporting LITELLM_API_KEY in your shell; never commit the real key.
LITELLM_API_KEY=
